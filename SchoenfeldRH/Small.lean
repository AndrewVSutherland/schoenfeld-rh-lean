import SchoenfeldRH.Small.Check
import SchoenfeldRH.Small.Data

/-!
# Schoenfeld's bound on the finite range `[73.2, 30000]`

`schoenfeld_small`: `|ψ(x) - x| < √x log² x / (8π)` for all real `73.2 ≤ x ≤ 30000`, unconditionally.

The proof is the soundness theorem `Small.bound_of_walk` (`SchoenfeldRH/Small/Check.lean`) applied to one
kernel evaluation, `Small.walk_data` below, of the checker `Small.walk` on the 139 intervals of
`Small.data` (`SchoenfeldRH/Small/Data.lean`, generated by `scripts/small/gen.py`).  The evaluation uses
exact arithmetic in `ℕ` only: it walks `n = 1, …, 30000`, keeping `lcm(1..n)` (so `ψ(n) = log lcm(1..n)`
is known exactly), and checks two integer inequalities per interval.
-/

namespace SchoenfeldRH

open Chebyshev

namespace Small

/-- The certificate: the walk over `data` succeeds, starting from `lcm(1..73)` (computed by `lcmRun`)
and ending at `dataEnd = 30001`.  One kernel evaluation, a few seconds in every checker. -/
theorem walk_data : walk dataEnd data 73 (lcmRun 73 73 1) = true := by decide +kernel

end Small

/-- **Schoenfeld's bound on `[73.2, 30000]`** (unconditional). -/
theorem schoenfeld_small (x : ℝ) (h1 : 73.2 ≤ x) (h2 : x ≤ 30000) :
    |Chebyshev.psi x - x| < Real.sqrt x * Real.log x ^ 2 / (8 * Real.pi) := by
  have h0 : Small.lcmRun 73 73 1 = Nat.lcmUpto 73 := by
    have := Small.lcmRun_lcmUpto (b := 73) (cnt := 73) le_rfl
    rwa [Nat.sub_self, Small.lcmUpto_zero] at this
  have hw := Small.walk_data
  rw [h0] at hw
  refine Small.bound_of_walk Small.dataEnd Small.data 73 hw x ?_ ?_
  · norm_num at h1 ⊢; linarith
  · norm_num [Small.dataEnd]; linarith

end SchoenfeldRH
